#. module: ssi_school_student_leave
#: code:addons/ssi_school_student_leave/models/school_student_leave.py:0
#, python-format
msgid ""
"\n"
"Context: Change student leave state into %s\n"
"Database ID: %s\n"
"Problem: Another leave for student '%s' is already draft or waiting\n"
"for approval\n"
"Solution: Complete, reject, or cancel the other leave before\n"
"confirming this one\n"
msgstr ""
"\n"
"Konteks: Mengubah status cuti siswa menjadi %s\n"
"ID Basis Data: %s\n"
"Masalah: Cuti lain untuk siswa '%s' sudah berstatus draf atau menunggu\n"
"persetujuan\n"
"Solusi: Selesaikan, tolak, atau batalkan cuti lainnya sebelum\n"
"mengonfirmasi cuti ini\n"

#. module: ssi_school_student_leave
#: code:addons/ssi_school_student_leave/models/school_student_leave.py:0
#, python-format
msgid ""
"\n"
"Context: Change student leave state into %s\n"
"Database ID: %s\n"
"Problem: Student '%s' is not in enrol state\n"
"Solution: The student must be enrolled before this leave can be\n"
"confirmed or completed\n"
msgstr ""
"\n"
"Konteks: Mengubah status cuti siswa menjadi %s\n"
"ID Basis Data: %s\n"
"Masalah: Siswa '%s' tidak berstatus terdaftar\n"
"Solusi: Siswa harus terdaftar sebelum cuti ini dapat\n"
"dikonfirmasi atau diselesaikan\n"

#. module: ssi_school_student_leave
#: code:addons/ssi_school_student_leave/models/school_student_leave.py:0
#, python-format
msgid ""
"\n"
"Context: Complete student leave\n"
"Database ID: %s\n"
"Problem: Student '%s' is no longer in enrol state\n"
"Solution: Cancel this leave; the student must stay enrolled until\n"
"the leave is completed\n"
msgstr ""
"\n"
"Konteks: Menyelesaikan cuti siswa\n"
"ID Basis Data: %s\n"
"Masalah: Siswa '%s' tidak lagi berstatus terdaftar\n"
"Solusi: Batalkan cuti ini; siswa harus tetap terdaftar sampai\n"
"cuti selesai\n"

#. module: ssi_school_student_leave
#: code:addons/ssi_school_student_leave/models/school_student_leave.py:0
#, python-format
msgid ""
"\n"
"Context: Return student from leave\n"
"Database ID: %s\n"
"Problem: Student '%s' is not currently on leave\n"
"Solution: This action is only valid when the student is in on_leave\n"
"state\n"
msgstr ""
"\n"
"Konteks: Mengembalikan siswa dari cuti\n"
"ID Basis Data: %s\n"
"Masalah: Siswa '%s' saat ini tidak sedang cuti\n"
"Solusi: Tindakan ini hanya berlaku ketika siswa berstatus on_leave\n"

