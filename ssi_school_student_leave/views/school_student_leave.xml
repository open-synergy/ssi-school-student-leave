<odoo>
<record id="school_student_leave_view_search" model="ir.ui.view">
    <field name="name">school_student_leave - search</field>
    <field name="model">school_student_leave</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="student_id" />
                <field name="academic_term_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_student_id"
                            string="Student"
                            context="{'group_by': 'student_id'}"
                        />
                    <filter
                            name="group_by_academic_term_id"
                            string="Academic Term"
                            context="{'group_by': 'academic_term_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_student_leave_view_tree" model="ir.ui.view">
    <field name="name">school_student_leave - tree</field>
    <field name="model">school_student_leave</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="student_id" />
                <field name="academic_term_id" />
                <field name="expected_return_date" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_student_leave_view_form" model="ir.ui.view">
    <field name="name">school_student_leave - form</field>
    <field name="model">school_student_leave</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                        name="action_return"
                        type="object"
                        string="Return"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="student_id" />
                <field name="active_enrollment_id" />
                <field name="academic_term_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="expected_return_date" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="leave" string="Leave">
                    <group name="leave_reason" string="Reason">
                        <field name="reason" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_student_leave_action" model="ir.actions.act_window">
    <field name="name">Student Leaves</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_student_leave</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_student_leave_menu"
        name="Student Leaves"
        parent="ssi_school.menu_school_student_activity"
        action="school_student_leave_action"
        groups="school_student_leave_viewer_group"
        sequence="30"
    />

</odoo>
